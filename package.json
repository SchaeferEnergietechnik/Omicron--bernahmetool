{
  "name": "omicron-uebernahmetool",
  "main": "electron/main.cjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "worker:build:win": "py -3 -m PyInstaller --noconfirm --clean --onefile --name occ_worker --distpath worker/dist --workpath worker/build --specpath worker/build --hidden-import win32timezone --collect-all pywinauto --collect-all win32com worker/occ_worker.py",
    "worker:check:win": "node scripts/check-worker-exe.cjs",
    "desktop:dist": "npm run build && npm run worker:check:win && electron-builder --win"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "de.schaeferenergietechnik.omicron-uebernahmetool",
    "productName": "Omicron Übernahmetool",
    "files": ["dist/**/*", "electron/**/*", "worker/**/*", "package.json"],
    "asarUnpack": ["worker/**"],
    "win": { "target": "nsis" }
  }
}
